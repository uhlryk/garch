{
  "name": "@krzysztofsztompka/garch",
  "version": "0.2.0",
  "description": "GARCH, GJR-GARCH and EGARCH by maximum likelihood — normal, Student-t or skewed-t innovations, GARCH-X drivers — with forecasts, walk-forward validation, simulation, value at risk and diagnostics; DCC-GARCH for several assets; pure TypeScript, no runtime dependencies, worker pools for Node and the browser",
  "keywords": [
    "garch",
    "gjr-garch",
    "egarch",
    "volatility",
    "forecast",
    "time-series",
    "finance",
    "maximum-likelihood",
    "walk-forward",
    "student-t",
    "skewed-t",
    "value-at-risk",
    "expected-shortfall",
    "simulation",
    "web-workers",
    "dcc-garch",
    "garch-x",
    "correlation",
    "portfolio"
  ],
  "author": "Krzysztof Sztompka",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uhlryk/garch.git"
  },
  "homepage": "https://uhlryk.github.io/garch/",
  "bugs": "https://github.com/uhlryk/garch/issues",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/esm/node.d.ts",
        "default": "./dist/esm/node.js"
      },
      "require": {
        "types": "./dist/cjs/node.d.ts",
        "default": "./dist/cjs/node.js"
      }
    },
    "./web": {
      "import": {
        "types": "./dist/esm/web.d.ts",
        "default": "./dist/esm/web.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "node": [
        "./dist/cjs/node.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.esm.json && node build/finish.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "docs": "typedoc",
    "docs:check": "node scripts/check-readme.mjs",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/garch.test.js",
    "coverage": "tsc -p tsconfig.test.json && node --test --experimental-test-coverage --test-coverage-exclude='dist-test/test/**' --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=80 dist-test/test/garch.test.js",
    "bench": "npm run build && node scripts/bench.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.10.7",
    "typedoc": "^0.28.20",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
