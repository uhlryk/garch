{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts", "src/node.ts", "src/web.ts"],
  "tsconfig": "tsconfig.json",
  "out": "docs-site",
  "name": "@krzysztofsztompka/garch",
  "readme": "README.md",
  "excludePrivate": true,
  "excludeInternal": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "treatWarningsAsErrors": true,
  "requiredToBeDocumented": ["Enum", "Variable", "Function", "Class", "Interface", "TypeAlias"],
  "intentionallyNotExported": ["JOBS"]
}
